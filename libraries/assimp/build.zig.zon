.{
    .name = .zig_assimp,
    .version = "5.3.1",
    .fingerprint = 0x3e92a7cfbee36ef8,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "LICENCE",
        "README.md",
        "include",
        "src",
    },
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        .assimp = .{
            .url = "https://github.com/assimp/assimp/archive/v5.3.1.tar.gz",
            .hash = "N-V-__8AACI1agiq-JJtHIb-h7Td-FFZ-HgD1WOpv1g_Vl3w",
        },
        // Use the modern allyourcodebase zlib instead of assimp's ancient bundled contrib/zlib (which
        // doesn't compile on the current macOS SDK + Zig 0.16). Same rev freetype uses, so the two
        // dedup into a single zlib instance. Enabled via ASSIMP_BUILD_NO_OWN_ZLIB in build.zig.
        .zlib = .{
            .url = "git+https://github.com/allyourcodebase/zlib?ref=1.3.2#d3b5519d3b73616a6bfece0712f080029d2a9244",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
    },
}
